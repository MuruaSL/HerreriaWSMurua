{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/pages/portfolio.html",       "destination": "/pages/trabajos.html", "permanent": true },
    { "source": "/pages/quienes_somos.html",   "destination": "/pages/taller.html",   "permanent": true },
    { "source": "/pages/reconocimientos.html", "destination": "/pages/taller.html",   "permanent": true },
    { "source": "/pages/que_hacemos.html",     "destination": "/",                    "permanent": true }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }
      ]
    }
  ]
}
